AUTHORIZATION="Bearer xvz1evFS4wEEPTGEFPHBog"
JAMBO_AUTHORIZATION="Bearer jmb1evFS4wEEPTGEFPHBog"
RPC_URL="https://devnet.ixo.earth/rpc/"
MNEMONIC="seven panther slogan boy midnight foam rib scale aim spare click grace"
PORT=3000
SENTRY_DSN=""

# Postgres
DATABASE_URL="postgres://user:password@localhost:5432/ixo_feegrant"
DATABASE_USE_SSL=0
# Set to 1 to run pending migrations at process start.
MIGRATE_DB_PROGRAMATICALLY=0

# Refresh cron settings
# Endpoint used to backfill historical grantees from chain history.
BLOCKSYNC_GRAPHQL_URL="https://blocksync-graphql.ixo.earth/graphql"
# Set to 0 to disable the refresh cron (e.g. for one-off API-only deployments).
REFRESH_CRON_ENABLED=1
# Cron expression. Default: every 30 minutes.
REFRESH_CRON_SCHEDULE="0 */30 * * * *"
# Days each freshly-issued allowance lasts.
REFRESH_GRANT_DURATION_DAYS=365
# Max grantees per broadcast tx.
REFRESH_BATCH_SIZE=180
# Page size for blocksync GraphQL ingest.
BLOCKSYNC_PAGE_SIZE=1000
# Page size for chain allowancesByGranter pagination.
CHAIN_PAGE_SIZE=1000
